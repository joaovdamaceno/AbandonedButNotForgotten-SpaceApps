.root { flex-grow:1; color:rgb(241,235,218); font-size:22px; }
.root.large-text { font-size:27px; }
.row { flex-direction:row; align-items:center; }
.eyebrow { font-size:17px; letter-spacing:3px; color:rgb(200,214,200); margin-bottom:12px; }
.small { font-size:18px; }
.muted { color:rgba(237,229,209,.72); }
.display { -unity-font-style:normal; }
.edge-shade { position:absolute; left:0; right:0; top:0; bottom:0; background-color:rgba(13,17,21,.03); }
.flight,.cinema,.science,.photo-view { position:absolute; left:0; right:0; top:0; bottom:0; }
.button { background-color:rgba(20,27,30,.5); color:rgb(239,232,217); font-size:21px; border-width:0; border-radius:0; padding:12px 22px; margin:5px 8px 5px 0; min-height:48px; }
.button:hover { background-color:rgba(215,199,168,.22); }
.button:focus { border-bottom-width:1px; border-bottom-color:rgb(190,221,211); }
.button.primary { align-self:flex-start; font-size:24px; background-color:rgba(221,207,180,.91); color:rgb(31,38,39); padding:13px 36px; margin-bottom:21px; }
.identity { position:absolute; top:5%; left:4%; }
.identity .eyebrow { margin-bottom:6px; font-size:15px; }
.goal { position:absolute; left:4%; bottom:11%; max-width:700px; border-left-width:2px; border-left-color:rgba(185,219,209,.7); padding-left:19px; }
.objective { font-size:27px; margin-bottom:5px; white-space:normal; }
.controls { position:absolute; bottom:4.8%; left:4%; font-size:18px; color:rgba(244,232,209,.78); }
.solar { position:absolute; right:4%; bottom:5.5%; width:230px; }
.solar .eyebrow { font-size:14px; letter-spacing:1px; }
.energy-track,.progress-track { height:3px; background-color:rgba(228,221,202,.17); }
.energy-fill,.progress-fill { height:100%; width:0; background-color:rgb(171,210,190); }
.marker { position:absolute; width:40px; height:40px; margin-left:-20px; margin-top:-20px; }
.marker-halo { position:absolute; left:4px; top:4px; width:32px; height:32px; rotate:45deg; background-color:rgba(18,136,227,.28); border-radius:5px; }
.marker-diamond { position:absolute; left:8px; top:8px; width:24px; height:24px; rotate:45deg; background-color:#1288e3; border-width:2px; border-color:#bfe4fb; border-radius:3px; }
.marker-bar { position:absolute; left:50%; top:13px; width:3px; height:8px; margin-left:-1.5px; background-color:rgb(255,255,255); border-radius:1.5px; }
.marker-dot { position:absolute; left:50%; top:24px; width:3px; height:3px; margin-left:-1.5px; background-color:rgb(255,255,255); border-radius:1.5px; }
.marker-glyph { display:none; position:absolute; left:0; right:0; top:0; bottom:0; -unity-text-align:middle-center; -unity-font-style:bold; font-size:26px; color:#1288e3; -unity-text-outline-width:1.5px; -unity-text-outline-color:rgb(255,255,255); }
.marker-edge .marker-halo, .marker-edge .marker-diamond, .marker-edge .marker-bar, .marker-edge .marker-dot { display:none; }
.marker-edge .marker-glyph { display:flex; }
.letterbox { position:absolute; left:0; right:0; height:7%; background-color:rgb(8,12,16); }
.top { top:0; } .bottom { bottom:0; }
.cinematic-words { position:absolute; bottom:15%; left:7%; max-width:1020px; }
.cinematic-heading { font-size:78px; margin-bottom:5px; }
.cinematic-story { font-size:28px; white-space:normal; }
.caption { position:absolute; bottom:9%; left:10%; right:10%; -unity-text-align:middle-center; font-size:21px; white-space:normal; }
.skip { position:absolute; right:4%; bottom:2.4%; font-size:14px; color:rgba(232,226,213,.48); }
.remembrance { position:absolute; width:33%; height:32%; right:7%; top:24%; border-width:1px; border-color:rgba(218,210,190,.45); background-color:rgb(17,21,23); }
.science-id { position:absolute; top:5%; left:5%; }
.science-instruction { position:absolute; bottom:11%; left:5%; max-width:900px; }
.science-body { font-size:21px; white-space:normal; max-width:840px; color:rgb(220,217,197); }
.tool-readout { position:absolute; right:5%; bottom:10%; width:280px; padding:15px; background-color:rgba(14,22,25,.72); }
.tool-readout .small { white-space:normal; margin:15px 0; font-size:17px; }
.pressure-track { height:7px; background-color:rgba(210,208,183,.16); }
.pressure-fill { height:100%; }
.safe-band { position:absolute; left:25%; width:53%; height:13px; top:-3px; border-width:1px; border-color:rgba(190,221,199,.68); }
.tool-cursor { position:absolute; width:42px; height:42px; margin-left:-21px; margin-top:-21px; border-width:1px; border-color:rgba(228,241,220,.9); border-radius:25px; }
.feature { position:absolute; width:64px; height:64px; margin-left:-32px; margin-top:-32px; border-width:1px; border-color:rgba(235,211,153,.9); border-radius:40px; }
.feature-number { position:absolute; top:-26px; width:60px; -unity-text-align:middle-center; font-size:17px; color:rgb(247,225,176); }
.viewfinder { position:absolute; left:8%; right:8%; top:12%; bottom:15%; border-width:1px; border-color:rgba(235,235,210,.32); }
.photo-id { position:absolute; top:6%; left:8%; }
.photo-help { position:absolute; bottom:6%; align-self:center; font-size:20px; }
.photo-count { position:absolute; top:6%; right:8%; }
.photo-flash,.fade { position:absolute; left:0; right:0; top:0; bottom:0; opacity:0; }
.photo-flash { background-color:rgb(228,231,216); }
.fade { background-color:rgb(8,12,16); }
.toast { position:absolute; top:13%; align-self:center; font-size:23px; -unity-text-align:middle-center; padding:10px 25px; background-color:rgba(15,24,27,.66); max-width:1000px; white-space:normal; opacity:0; }
.modal-backdrop,.memory-screen { position:absolute; left:0; right:0; top:0; bottom:0; background-color:rgba(7,15,20,.92); justify-content:center; align-items:center; }
.modal-card,.settings-card,.credits-card,.journal-card,.memory-card { padding:35px 45px; width:780px; max-height:90%; }
.modal-card { width:550px; }
.settings-card { width:820px; height:910px; }
.credits-card,.journal-card { width:1050px; height:900px; }
.modal-title { font-size:59px; margin-bottom:25px; }
.settings-card .unity-base-field { margin-top:10px; margin-bottom:10px; min-height:32px; font-size:20px; color:rgb(228,222,203); }
.settings-card .unity-base-field__label { min-width:330px; }
.settings-card .unity-slider__input { min-width:220px; }
.settings-card .unity-base-field__input { background-color:rgb(47,59,62); color:rgb(239,234,217); }
.settings-card .unity-toggle__input { background-color:rgba(0,0,0,0); }
.credits-body,.journal-body { white-space:normal; font-size:22px; color:rgb(218,216,199); margin-bottom:25px; }
.journal-image { height:270px; margin-top:30px; margin-bottom:10px; }
.memory-card { width:1100px; align-items:center; }
.memory-title { font-size:60px; margin-bottom:20px; }
.chosen-image { width:820px; height:450px; background-color:rgb(7,13,17); }
.memory-choices { justify-content:center; margin:15px 0; }
.memory-thumb { width:128px; height:80px; background-color:rgb(18,27,31); border-width:1px; border-color:rgba(210,210,190,.22); border-radius:0; padding:3px; margin:3px; }
.memory-thumb Image { width:100%; height:100%; }
.memory-thumb.selected { border-color:rgb(179,222,201); border-width:2px; }
.end-screen { position:absolute; left:0; right:0; top:0; bottom:0; align-items:center; justify-content:center; background-color:rgba(6,13,20,.4); }
.end-title { font-size:120px; }
.end-subtitle { white-space:normal; -unity-text-align:middle-center; font-size:24px; margin-bottom:35px; }
.large-text .controls,.large-text .small { font-size:23px; }
.large-text .science-body { font-size:25px; }
.large-text .objective { font-size:32px; }
.large-text .cinematic-story { font-size:34px; }


.remembrance { position:absolute; left:0; right:0; top:7%; bottom:7%; width:auto; height:auto; border-width:0; background-color:rgb(8,12,16); }

/* readable story subtitles and authored settings controls. */
.cinematic-words { top:12%; bottom:auto; left:7%; max-width:1050px; }
.caption { bottom:10%; left:14%; right:14%; font-size:25px; color:rgb(246,240,225); background-color:rgba(7,13,18,.58); padding:9px 19px; }
.large-text .caption { font-size:30px; }
.settings-card,.credits-card,.journal-card,.modal-card { background-color:rgb(16,25,31); border-left-width:1px; border-left-color:rgba(181,216,204,.6); }
.settings-card .unity-base-field__input { background-color:rgba(0,0,0,0); }
.settings-card .unity-base-slider__tracker { height:2px; background-color:rgba(218,221,207,.3); border-width:0; }
.settings-card .unity-base-slider__dragger { width:4px; height:17px; border-width:0; border-radius:0; background-color:rgb(180,215,201); }
.settings-card .unity-toggle__checkmark { width:19px; height:19px; border-width:1px; border-color:rgba(192,213,204,.5); background-color:rgb(25,39,46); }
.settings-card .unity-toggle:checked .unity-toggle__checkmark { background-color:rgb(64,99,93); border-color:rgb(180,215,201); }
.settings-card .unity-popup-field__input { background-color:rgb(25,39,46); border-color:rgba(192,213,204,.4); border-width:1px; padding:7px; }

.caption { left:18%; right:18%; font-size:27px; }

/* memorial typography and image-only fades. */
.film-veil { position:absolute; left:0; right:0; top:0; bottom:0; background-color:rgb(0,0,0); opacity:0; }
.cinematic-words.memorial-title { top:37%; left:0; right:0; max-width:none; align-items:center; }
.memorial-title .cinematic-heading { color:rgb(232,226,213); -unity-text-align:middle-center; }
.memorial-title .cinematic-story { font-size:20px; letter-spacing:5px; margin-top:12px; color:rgb(155,157,156); }
.end-title { font-size:76px; letter-spacing:10px; margin-bottom:20px; }

/* the memorial title persists into quiet chapter controls. */
.end-screen { background-color:rgb(0,0,0); }
.end-words { position:absolute; top:37%; left:0; right:0; align-items:center; }
.end-title { font-size:64px; letter-spacing:9px; color:rgb(232,226,213); margin-top:0; margin-bottom:5px; }
.end-dates { font-size:20px; letter-spacing:5px; margin-top:12px; color:rgb(155,157,156); }
.end-actions { position:absolute; bottom:12%; align-self:center; }

.thermal-cue { margin-top:8px; border-top-width:1px; border-top-color:rgba(209,150,81,.35); }
.thermal-cue .small { color:rgb(236,179,104); margin:8px 0; font-size:16px; }
.thermal-fill { height:4px; background-color:rgb(210,122,55); }

.field-study { position:absolute; left:0; right:0; top:0; bottom:0; background-color:rgba(0,0,0,.06); }
.field-title { position:absolute; left:6%; top:8%; font-size:24px; letter-spacing:3px; color:rgb(217,233,225); }
.field-body { position:absolute; left:6%; top:16%; width:48%; font-size:21px; white-space:normal; color:rgb(241,231,214); text-shadow:1px 1px 3px black; }
.field-reticle { position:absolute; width:32px; height:32px; margin-left:-16px; margin-top:-16px; border-width:1px; border-color:rgb(232,172,102); border-radius:16px; }
.field-reticle.stable { border-color:rgb(151,213,189); }
.field-status { position:absolute; left:6%; bottom:12%; font-size:18px; color:rgb(235,227,211); }
.field-track { position:absolute; left:6%; bottom:9%; width:270px; height:3px; background-color:rgba(255,255,255,.14); }
.field-progress { height:3px; background-color:rgb(151,213,189); }
.field-comparison { position:absolute; left:14%; right:14%; top:35%; bottom:25%; flex-direction:row; background-color:rgba(0,0,0,.65); }
.field-comparison > Image { width:50%; height:100%; margin-left:3px; margin-right:3px; }
.field-archive { position:absolute; right:6%; top:12%; width:32%; height:43%; background-color:rgba(0,0,0,.5); }
.field-credit { position:absolute; right:6%; top:56%; width:32%; font-size:13px; color:rgb(205,198,184); white-space:normal; }

.orbital-evidence { position:absolute; right:8%; top:27%; width:29%; height:43%; background-color:rgba(0,0,0,.45); }
.orbital-credit { position:absolute; right:8%; top:72%; width:29%; font-size:13px; color:rgb(213,208,193); }

.comparison-label { position:absolute; bottom:8px; left:12px; font-size:16px; color:white; background-color:rgba(0,0,0,.35); padding-left:8px; padding-right:8px; padding-top:3px; padding-bottom:3px; }

.large-text .field-title { font-size:28px; }
.large-text .field-body { font-size:25px; }
.large-text .field-status { font-size:23px; }
.large-text .comparison-label { font-size:20px; }

/* a fixed optical centre and a target anchored to the scene. */
.field-center { position:absolute; left:50%; top:50%; width:18px; height:18px; margin-left:-9px; margin-top:-9px; border-width:1px; border-color:rgba(246,229,201,.9); border-radius:9px; }
.field-center.stable { border-width:2px; border-color:rgb(151,213,189); }
.field-reticle { width:56px; height:56px; margin-left:-28px; margin-top:-28px; border-width:2px; border-radius:28px; border-color:rgba(232,172,102,.8); }
.framing-track { position:absolute; left:50%; top:62%; width:180px; margin-left:-90px; height:3px; background-color:rgba(241,225,193,.16); }
.framing-fill { height:3px; background-color:rgb(187,211,188); }
.field-comparison { left:6%; right:6%; top:42%; bottom:17%; padding:6px; background-color:rgba(4,10,13,.9); }
.field-comparison > Image { height:100%; margin-left:0; margin-right:0; }
.comparison-label { font-size:16px; background-color:rgba(5,10,14,.78); padding:5px 8px; }
.field-credit { left:6%; right:6%; top:auto; bottom:13%; width:auto; font-size:14px; }
.field-status { bottom:7%; font-size:21px; }
.field-track { bottom:5%; }
/* Centre the visible group; no inherited primary-button left alignment. */
.modal-card { position:relative; left:auto; top:auto; translate:0 0; width:560px; max-width:90%; max-height:90%; flex-shrink:0; padding:32px 38px; align-items:stretch; }
.modal-card .eyebrow { -unity-text-align:middle-center; margin-bottom:12px; }
.modal-card .modal-title { font-size:43px; white-space:normal; -unity-text-align:middle-center; margin-bottom:22px; }
.modal-card .button { align-self:stretch; margin-left:0; margin-right:0; width:auto; -unity-text-align:middle-center; }
.modal-card .button.primary { align-self:stretch; font-size:24px; margin-bottom:12px; }
.large-text .modal-card .modal-title { font-size:46px; }
.interaction-hint { position:absolute; width:240px; margin-left:-120px; margin-top:-38px; align-items:center; }
.interaction-key { width:42px; height:42px; border-width:1px; border-color:rgba(215,232,218,.9); border-radius:21px; -unity-text-align:middle-center; font-size:25px; color:rgb(239,239,216); background-color:rgba(8,18,21,.82); }
.interaction-name { margin-top:7px; font-size:18px; -unity-text-align:middle-center; background-color:rgba(8,18,21,.78); padding:3px 10px; }


/* the archive is a lightweight, readable document before the mission. */
.dossier { position:absolute; left:0; right:0; top:0; bottom:0; padding:30px 5% 20px 5%; background-color:rgb(12,20,24); color:rgb(224,219,207); }
.dossier-masthead { justify-content:space-between; height:60px; flex-shrink:0; border-bottom-width:1px; border-bottom-color:rgba(202,188,159,.18); margin-bottom:24px; }
.dossier-brand { font-size:18px; letter-spacing:4px; }
.dossier-languages .button { font-size:16px; min-height:34px; margin:0 0 0 6px; padding:4px 11px; background-color:rgba(0,0,0,0); color:rgb(145,160,158); }
.dossier-languages .selected { background-color:rgb(210,200,175); color:rgb(21,32,35); }
.dossier-desk { flex-grow:1; align-items:stretch; min-height:0; }
.dossier-rail { width:270px; flex-shrink:0; padding-top:23px; margin-right:30px; }
.dossier-rail-heading { font-size:13px; margin-bottom:23px; letter-spacing:2px; }
.dossier-folder { padding:22px 20px; background-color:rgb(36,46,48); border-left-width:3px; border-left-color:rgb(198,156,105); }
.dossier-file-index { color:rgb(174,177,161); font-size:13px; letter-spacing:2px; margin-bottom:15px; }
.dossier-file-title { font-size:34px; color:rgb(240,228,202); margin-bottom:6px; }
.dossier-file-dates { font-size:17px; letter-spacing:2px; color:rgb(181,183,169); }
.dossier-file-duration { font-size:15px; margin-top:23px; color:rgb(200,187,157); }
.dossier-rail-note { padding:28px 20px; }
.dossier-count { font-size:44px; color:rgb(91,112,111); }
.dossier-muted { color:rgb(132,151,150); font-size:16px; }
.dossier-paper { flex-grow:1; flex-shrink:1; min-width:0; background-color:rgb(232,224,204); color:rgb(39,48,48); padding:24px 35px 20px 35px; border-top-width:4px; border-top-color:rgb(179,131,81); }
.dossier-paper-top { justify-content:space-between; flex-shrink:0; margin-bottom:13px; }
.dossier-document-code { font-size:14px; letter-spacing:3px; color:rgb(78,91,85); }
.dossier-document-page { font-size:13px; letter-spacing:2px; color:rgb(99,108,95); }
.dossier-tabs { border-bottom-width:1px; border-bottom-color:rgba(61,78,71,.2); padding-bottom:8px; margin-bottom:17px; flex-shrink:0; }
.dossier-tabs .button { background-color:rgba(0,0,0,0); font-size:16px; color:rgb(90,102,90); padding:7px 15px; margin:0 8px 0 0; min-height:36px; }
.dossier-tabs .selected { color:rgb(29,54,52); background-color:rgba(38,72,65,.1); border-bottom-width:2px; border-bottom-color:rgb(62,97,81); }
.dossier-scroll { flex-grow:1; flex-shrink:1; min-height:0; }
.dossier-scroll .unity-scroller--vertical { width:9px; }
.dossier-scroll .unity-base-slider__tracker { background-color:rgba(50,72,62,.09); }
.dossier-scroll .unity-base-slider__dragger { background-color:rgba(50,72,62,.34); border-width:0; border-radius:0; }
.dossier-scroll .unity-scroller__low-button,.dossier-scroll .unity-scroller__high-button { display:none; }
.dossier-pages { padding-right:18px; padding-bottom:18px; }
.dossier-page-kicker { font-size:14px; letter-spacing:2px; color:rgb(119,93,59); margin-bottom:7px; }
.dossier-heading { font-size:48px; color:rgb(31,50,48); margin-bottom:15px; white-space:normal; }
.dossier-lead { font-size:22px; color:rgb(54,68,61); margin-bottom:17px; }
.dossier-wrap { white-space:normal; }
.dossier-figure { margin-bottom:17px; background-color:rgb(189,159,123); }
.dossier-cover { height:185px; width:100%; }
.dossier-image-credit { font-size:11px; color:rgb(79,77,64); background-color:rgb(218,207,181); padding:4px 8px; }
.dossier-facts { align-items:stretch; margin-bottom:17px; }
.dossier-fact { flex-grow:1; flex-basis:0; padding:9px 13px; border-left-width:1px; border-left-color:rgba(69,91,77,.25); }
.dossier-fact-label { font-size:12px; letter-spacing:1px; color:rgb(112,119,100); margin-bottom:5px; }
.dossier-fact-value { font-size:19px; color:rgb(36,63,58); }
.dossier-body { font-size:21px; color:rgb(66,79,68); margin-bottom:13px; }
.dossier-section-title { font-size:25px; color:rgb(40,66,59); margin-top:15px; margin-bottom:9px; white-space:normal; }
.dossier-timeline-row { align-items:flex-start; margin-bottom:5px; }
.dossier-year { width:85px; flex-shrink:0; font-size:21px; color:rgb(135,97,54); }
.dossier-timeline-text { flex-grow:1; flex-shrink:1; }
.dossier-bottom { flex-shrink:0; border-top-width:1px; border-top-color:rgba(61,78,71,.2); padding-top:13px; }
.dossier-status { font-size:14px; color:rgb(101,115,96); margin-bottom:7px; }
.dossier-loading-track { height:2px; background-color:rgba(34,63,53,.16); margin-bottom:7px; }
.dossier-loading-fill { height:2px; background-color:rgb(53,102,82); }
.dossier-actions { justify-content:space-between; }
.dossier-actions .button.primary { background-color:rgb(34,64,58); color:rgb(238,232,212); font-size:22px; min-height:52px; margin:0 20px 0 0; padding:11px 27px; align-self:stretch; }
.dossier-actions .button:disabled { opacity:.4; }
.dossier-input { font-size:15px; max-width:260px; color:rgb(107,119,100); }
.dossier-footer { flex-shrink:0; justify-content:flex-start; min-height:61px; padding-top:13px; }
.dossier-footer .button { background-color:rgba(0,0,0,0); padding:5px 15px 5px 0; font-size:16px; min-height:32px; color:rgb(165,178,168); }
.dossier-legal { font-size:13px; color:rgb(110,131,129); margin-left:15px; flex-grow:1; flex-shrink:1; -unity-text-align:middle-right; }
.dossier-source.button { background-color:rgba(57,87,70,.08); color:rgb(42,81,65); align-self:flex-start; font-size:17px; margin-top:3px; margin-bottom:3px; min-height:38px; padding:7px 12px; }
.dossier-source-note { font-size:16px; margin-top:17px; }
.dossier-settings-card { color:rgb(228,222,203); }
.large-text .dossier-body,.large-text .dossier-lead { font-size:25px; }
.large-text .dossier-fact-value { font-size:23px; }
.large-text .dossier-input { font-size:18px; }
.tutorial-card { position:absolute; top:16%; left:4%; width:570px; max-width:52%; padding:15px 20px; border-left-width:2px; border-left-color:rgb(166,206,189); background-color:rgba(9,22,25,.86); }
.tutorial-title { font-size:22px; color:rgb(218,233,219); margin-bottom:7px; white-space:normal; }
.tutorial-body { font-size:19px; color:rgb(201,210,195); white-space:normal; }
.tutorial-focus { border-left-color:rgb(235,218,161); background-color:rgba(12,30,32,.78); padding-top:10px; padding-bottom:10px; padding-right:17px; }
.assistance-card { position:absolute; right:4%; top:15%; max-width:410px; padding:12px 16px; background-color:rgba(12,29,32,.88); border-right-width:2px; border-right-color:rgb(156,194,180); }
.assistance-text { font-size:18px; white-space:normal; color:rgb(213,228,211); }
.assistance-card.strong { background-color:rgba(40,34,24,.9); border-right-color:rgb(218,179,115); }
.flight-pause.button { position:absolute; top:4%; right:4%; min-height:36px; font-size:15px; padding:6px 12px; margin:0; color:rgb(202,217,201); background-color:rgba(10,22,26,.5); }
.interaction-name { max-width:280px; white-space:normal; }
.large-text .tutorial-title { font-size:26px; }
.large-text .tutorial-body,.large-text .assistance-text { font-size:23px; }

.controls-card { width:820px; max-width:94%; max-height:90%; padding:32px 40px; background-color:rgb(16,25,31); border-left-width:1px; border-left-color:rgba(181,216,204,.6); }
.controls-card .modal-title { font-size:43px; -unity-text-align:middle-center; margin-bottom:18px; }
.controls-row { flex-direction:row; align-items:center; padding:9px 0; border-bottom-width:1px; border-bottom-color:rgba(192,213,204,.15); }
.controls-key { width:210px; flex-shrink:0; font-size:20px; -unity-font-style:bold; color:#bfe4fb; white-space:normal; }
.controls-desc { flex-grow:1; flex-shrink:1; font-size:19px; color:rgb(228,222,203); white-space:normal; }

/* twin landings in a horizontal split screen, one-key interaction guidance, mission goals. */
.split-view { position:absolute; left:0; right:0; top:0; bottom:0; }
.split-divider { position:absolute; left:0; right:0; height:4px; margin-top:-2px; background-color:rgba(244,232,209,.9); }
.split-label { position:absolute; left:4.5%; padding:6px 16px 8px 14px; border-left-width:3px; border-left-color:rgb(236,176,104); background-color:rgba(6,11,14,.62); }
.split-name { font-size:27px; letter-spacing:2px; color:rgb(250,244,230); margin-bottom:2px; }
.split-place { font-size:17px; letter-spacing:1px; color:rgb(240,196,140); white-space:normal; }
.split-note { position:absolute; right:3%; max-width:620px; font-size:17px; white-space:normal; -unity-text-align:lower-right; color:rgba(244,236,220,.82); background-color:rgba(6,11,14,.5); padding:4px 10px; }
.controls { font-size:26px; bottom:4.4%; left:3.5%; color:rgba(250,242,222,.94); background-color:rgba(7,15,18,.55); padding:8px 16px; border-left-width:3px; border-left-color:rgb(166,206,189); }
.large-text .controls { font-size:30px; }
.interaction-sub { margin-top:4px; font-size:16px; color:rgb(240,214,160); -unity-text-align:middle-center; background-color:rgba(8,18,21,.78); padding:2px 10px; }
.goal-line,.field-goal { font-size:17px; white-space:normal; color:rgb(240,200,146); margin-top:10px; max-width:840px; }
.field-goal { position:absolute; left:6%; bottom:15%; width:46%; }
.field-status { font-size:26px; bottom:7.5%; color:rgb(250,243,225); }
.tutorial-title { font-size:28px; }
.tutorial-body { font-size:24px; }
.tutorial-card { width:680px; max-width:60%; }
.large-text .tutorial-title { font-size:32px; }
.large-text .tutorial-body { font-size:28px; }

/* Legenda das cenas: mesma placa da abertura (fundo escuro, cantos arredondados, Outfit Medium), um pouco menor. */
.caption { left:13%; right:13%; bottom:6.5%; width:auto; font-size:28px; color:rgb(238,235,220); background-color:rgba(4,6,7,.5); border-radius:8px; padding:8px 24px; -unity-font-definition:url("/Assets/_Game/Shared/Fonts/Outfit/Outfit-Medium.ttf"); -unity-text-align:middle-center; white-space:normal; }
.toast { color:rgb(238,235,220); background-color:rgba(4,6,7,.5); border-radius:8px; padding:8px 24px; font-size:22px; -unity-font-definition:url("/Assets/_Game/Shared/Fonts/Outfit/Outfit-Medium.ttf"); }
/* Aviso no meio da tela antes da primeira observação. */
.explore-hint { position:absolute; top:46%; left:50%; translate:-50% 0; font-size:24px; color:rgb(238,235,220); background-color:rgba(4,6,7,.5); border-radius:8px; padding:8px 16px; -unity-font-definition:url("/Assets/_Game/Shared/Fonts/Outfit/Outfit-Medium.ttf"); -unity-text-align:middle-center; }
