%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76d343dc185c2b347b772b0bdcce69c8, type: 3}
  m_Name: PioneerCueMap
  m_EditorClassIdentifier: Abandoned.SpaceApps::Abandoned.SpaceApps.PioneerCueMap
  cancelFadeSeconds: 0.5
  states:
  - stateId: PIO.Launch
    musicCueId: MUS_PIO_LANCAMENTO
    fadeSeconds: 1.75
    note: "Chronicle: come\xE7a quase em sil\xEAncio e sobe; no espa\xE7o s\xF3 m\xFAsica."
  - stateId: PIO.Belt
    musicCueId: MUS_PIO_CINTURAO
    fadeSeconds: 1.75
    note: "Descent: o medo do cintur\xE3o (escura e misteriosa). O corte para a calma da revela\xE7\xE3o \xE9 do MUS_PIO_MARAVILHA."
  - stateId: PIO.JupiterApproach
    musicCueId: MUS_PIO_JUPITER
    fadeSeconds: 1.75
    note: "Sanctum: orquestral e edificante, para a radia\xE7\xE3o, o mergulho e o empurr\xE3o gravitacional."
  - stateId: PIO.Imaging
    musicCueId: MUS_PIO_MARAVILHA
    fadeSeconds: 1.75
    note: 'The Distant Sun: calma e discreta, para a foto montada linha por linha.'
  - stateId: PIO.Plaque
    musicCueId: MUS_PIO_ANOS
    fadeSeconds: 1.75
    note: "Extrapolation: piano sombrio com um fio de esperan\xE7a."
  - stateId: PIO.Outbound
    musicCueId: MUS_PIO_ANOS
    fadeSeconds: 1.75
    note: 'Mesmo cue da placa: segue sem reiniciar.'
  - stateId: PIO.Listening
    musicCueId: MUS_PIO_RADIO
    fadeSeconds: 1.75
    note: "Signal to Noise: misteriosa, melanc\xF3lica e esperan\xE7osa; o sil\xEAncio real de 2,5 s \xE9 pedido ao \xE1udio."
  - stateId: PIO.Farewell
    musicCueId: MUS_PIO_FINAL
    fadeSeconds: 1.75
    note: "Filaments (trecho do cl\xEDmax): o tema resolve; nenhum efeito externo."
  events:
  - eventId: PIO.Launch.Ignition
    action: 0
    cueId: SFX_PIO_LAUNCH
    level: 1
    seconds: 0
    proposedEvent: 0
    note: "SFX de lan\xE7amento na Terra; no espa\xE7o s\xF3 m\xFAsica."
  - eventId: PIO.Belt.Reality
    action: 1
    cueId: 
    level: 0.15
    seconds: 1.5
    proposedEvent: 0
    note: "A m\xFAsica quase silencia na virada (1,5 s). O n\xEDvel 0,15 \xE9 escolha desta tarefa para \"quase silencia\"; volta a 1 ao trocar de estado."
  - eventId: PIO.Belt.Recorded
    action: 0
    cueId: SFX_PIO_DETECTOR_TICK
    level: 1
    seconds: 0
    proposedEvent: 1
    note: "Tique de detector por registro. Hoje \xE9 o evento C# BeltInvestigation.Recorded; PIO-014 o liga a este ID."
  - eventId: PIO.Imaging.Sweep
    action: 0
    cueId: SFX_SCAN
    level: 1
    seconds: 0
    proposedEvent: 0
    note: Varredura em loop modulado, limitada a 40 s.
  - eventId: PIO.Imaging.Gate6
    action: 0
    cueId: SFX_PIO_RADIATION_NOISE
    level: 1
    seconds: 0
    proposedEvent: 0
    note: "Ru\xEDdo de radia\xE7\xE3o curto e de baixa amplitude, s\xF3 no quadro do instrumento."
  - eventId: PIO.Imaging.GateRecovery
    action: 0
    cueId: SFX_CMD_SENT
    level: 1
    seconds: 0
    proposedEvent: 0
    note: "Envio do comando de recupera\xE7\xE3o."
  - eventId: PIO.Listening.Tune
    action: 0
    cueId: SFX_RADIO_NOISE
    level: 1
    seconds: 0
    proposedEvent: 1
    note: "Ru\xEDdo de r\xE1dio de banda limitada e dura\xE7\xE3o limitada (12 s); \xE9 interface, n\xE3o som espacial."
  - eventId: PIO.Listening.Contact1
    action: 0
    cueId: SFX_RADIO_RECEIVED
    level: 1
    seconds: 0
    proposedEvent: 1
    note: Acorde de sinal recebido (1 de 3).
  - eventId: PIO.Listening.Contact2
    action: 0
    cueId: SFX_RADIO_RECEIVED
    level: 1
    seconds: 0
    proposedEvent: 1
    note: Acorde de sinal recebido (2 de 3).
  - eventId: PIO.Listening.Contact3
    action: 0
    cueId: SFX_RADIO_RECEIVED
    level: 1
    seconds: 0
    proposedEvent: 1
    note: Acorde de sinal recebido (3 de 3), mais fraco.
  - eventId: PIO.Listening.Attempt4
    action: 2
    cueId: 
    level: 1
    seconds: 2.5
    proposedEvent: 1
    note: "Tentativa 4 sem resposta: sil\xEAncio real de 2,5 s, sem hiss em loop."
  cues:
