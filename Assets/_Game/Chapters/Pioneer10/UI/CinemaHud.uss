/* Roteiro v2 · HUD dos planos de cinema da Pioneer 10. Usa tokens/componentes da UI-001; só o específico fica aqui. */

.pio-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Estática: ruído que cobre o quadro (a vista troca o deslocamento a cada quadro) com opacidade pela radiação. */
.pio-hud__static {
    position: absolute;
    left: -64px;
    top: -64px;
    right: -64px;
    bottom: -64px;
    opacity: 0;
    display: none;
}

.pio-hud__radiation,
.pio-hud__speed,
.pio-hud__distances {
    position: absolute;
    display: none;
    padding: var(--sa-space-3) var(--sa-space-4);
}

.pio-hud__radiation {
    left: 3%;
    top: 6%;
    width: 24%;
}

.pio-hud__speed {
    right: 3%;
    top: 6%;
}

.pio-hud__distances {
    left: 50%;
    bottom: 22%;
    width: 36%;
    translate: -50% 0;
}

.pio-hud__title,
.pio-hud__caption {
    font-size: var(--sa-text-label);
    color: var(--sa-color-on-plate);
    margin: 0;
    padding: 0;
}

.pio-hud__value {
    font-size: var(--sa-text-title);
    color: var(--sa-color-on-plate);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.pio-hud__track {
    height: 10px;
    margin-top: var(--sa-space-2);
    margin-bottom: var(--sa-space-3);
    background-color: rgba(245, 241, 232, 0.16);
    border-radius: 5px;
}

.pio-hud__fill {
    height: 100%;
    width: 0;
    border-radius: 5px;
    background-color: rgb(255, 186, 74);
}

.pio-hud__fill--moon {
    background-color: rgb(173, 190, 214);
}

.pio-hud__fill--clouds {
    background-color: rgb(255, 214, 120);
}

/* ---------- Cena 7 · Os anos ---------- */

.pio-hud__years {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.pio-hud__headline {
    position: absolute;
    left: 50%;
    top: 5%;
    min-width: 36%;
    padding: var(--sa-space-3) var(--sa-space-4);
    translate: -50% 0;
    align-items: center;
}

.pio-hud__year {
    font-size: var(--sa-text-title);
    color: var(--sa-color-on-plate);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.pio-hud__note {
    font-size: var(--sa-text-label);
    color: var(--sa-color-on-plate);
    opacity: 0.78;
    margin: 0;
    padding: 0;
}

.pio-hud__instruments {
    position: absolute;
    left: 3%;
    top: 24%;
    padding: var(--sa-space-3) var(--sa-space-4);
}

.pio-hud__inst {
    flex-direction: row;
    align-items: center;
    margin-top: var(--sa-space-2);
}

.pio-hud__inst--off {
    opacity: 0.28;
}

.pio-hud__icon {
    width: 26px;
    height: 26px;
    margin-right: var(--sa-space-3);
    border-width: 2px;
    border-color: rgb(255, 214, 120);
    align-items: center;
    justify-content: center;
}

.pio-hud__icon--camera {
    border-radius: 5px;
}

.pio-hud__icon--ring {
    border-radius: 13px;
}

.pio-hud__glyph {
    background-color: rgb(255, 214, 120);
}

.pio-hud__glyph--dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
}

.pio-hud__glyph--ring {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgb(255, 214, 120);
}

.pio-hud__glyph--diamond {
    width: 9px;
    height: 9px;
    rotate: 45deg;
}

.pio-hud__glyph--bar {
    width: 12px;
    height: 3px;
}

.pio-hud__energy {
    position: absolute;
    right: 3%;
    top: 24%;
    width: 22%;
    padding: var(--sa-space-3) var(--sa-space-4);
}

.pio-hud__gauge {
    position: relative;
    height: 230px;
    margin-top: var(--sa-space-3);
}

.pio-hud__vtrack {
    position: absolute;
    right: 6px;
    top: 0;
    bottom: 0;
    width: 22px;
    background-color: rgba(245, 241, 232, 0.16);
    border-radius: 5px;
    justify-content: flex-end;
}

.pio-hud__vfill {
    width: 100%;
    height: 50%;
    border-radius: 5px;
    background-color: rgb(255, 186, 74);
}

.pio-hud__mark {
    position: absolute;
    right: 0;
    width: 34px;
    height: 2px;
    background-color: rgb(245, 241, 232);
}

.pio-hud__mark--launch {
    top: 0;
}

.pio-hud__mark--jupiter {
    top: 9.7%;
}

.pio-hud__marklabel {
    position: absolute;
    right: 42px;
    font-size: var(--sa-text-label);
    color: var(--sa-color-on-plate);
    margin: 0;
    padding: 0;
}

.pio-hud__marklabel--launch {
    top: -6px;
}

.pio-hud__marklabel--jupiter {
    top: 9.7%;
    margin-top: -6px;
}

.pio-hud__timeline {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 9%;
    height: 44px;
}

.pio-hud__tline {
    position: absolute;
    left: 0;
    right: 0;
    top: 12px;
    height: 2px;
    background-color: rgba(245, 241, 232, 0.7);
}

.pio-hud__ticks {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.pio-hud__tick {
    position: absolute;
    top: 8px;
    width: 2px;
    height: 10px;
    background-color: rgba(245, 241, 232, 0.7);
}

.pio-hud__tick--event {
    top: 4px;
    height: 18px;
    background-color: rgb(255, 214, 120);
}

.pio-hud__ticklabel {
    position: absolute;
    top: 24px;
    width: 52px;
    margin-left: -26px;
    -unity-text-align: upper-center;
    font-size: var(--sa-text-label);
    color: var(--sa-color-on-plate);
    padding: 0;
}

.pio-hud__marker {
    position: absolute;
    top: 6px;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border-radius: 7px;
    background-color: rgb(255, 186, 74);
    border-width: 2px;
    border-color: rgb(245, 241, 232);
}
