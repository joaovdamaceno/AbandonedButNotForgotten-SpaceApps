/* PIO-012 · Painel da despedida. Usa tokens/componentes da UI-001; só o que é específico da Pioneer fica aqui. */

.pio-farewell {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---------- Guia de Aldebaran (discreto, canto inferior direito) ---------- */

.pio-farewell__guide {
    display: none;
    position: absolute;
    right: var(--sa-safe-margin);
    bottom: 150px;
    flex-direction: row;
    align-items: center;
    margin: 0;
}

/* Losango pequeno: marca a direção, sem fingir que há uma estrela modelada ali. */
.pio-farewell__guide-mark {
    width: 14px;
    height: 14px;
    margin-right: var(--sa-space-3);
    rotate: 45deg;
    background-color: #FF9A6B;
}

.pio-farewell__guide-label {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("/Assets/_Game/Shared/Fonts/Outfit/Outfit-SemiBold.ttf");
    font-size: var(--sa-text-hud);
    color: var(--sa-color-on-plate);
    white-space: nowrap;
}

/* ---------- Memorial: preto intencional ---------- */

.pio-farewell__black {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #000000;
}

.pio-farewell__memorial {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 32%;
    align-items: center;
    /* Same end screen as every chapter: a quiet kicker line above the big title. */
    flex-direction: column-reverse;
}

.pio-farewell__title {
    margin: 0;
    padding: 0 var(--sa-space-5);
    -unity-font-definition: url("/Assets/_Game/Shared/Fonts/Outfit/Outfit-Bold.ttf");
    font-size: var(--sa-text-display);
    letter-spacing: 8px;
    color: var(--sa-color-on-plate);
    -unity-text-align: middle-center;
    white-space: normal;
}

.pio-farewell__subtitle {
    margin: 0 0 var(--sa-space-3) 0;
    letter-spacing: 4px;
    padding: 0 var(--sa-space-5);
    -unity-font-definition: url("/Assets/_Game/Shared/Fonts/Outfit/Outfit-SemiBold.ttf");
    font-size: var(--sa-text-subtitle);
    color: var(--sa-color-on-plate-muted);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Ações finais ---------- */

.pio-farewell__choices {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 90px;
    flex-direction: column;
    align-items: center;
}

/* Same buttons as the Surveyor 3 and Mars end menus: compact, flat, green primary ("Main menu") and a quiet secondary. */
.pio-farewell__button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 280px;
    margin: 0 0 10px 0;
    padding: 10px 18px;
    border-width: 1px;
    border-color: rgba(178, 193, 169, 0.4);
    border-radius: 2px;
    background-color: rgba(195, 202, 182, 0.07);
}

.pio-farewell__button:hover { background-color: rgba(195, 202, 182, 0.16); }

/* The E keycap stays out of this menu so the buttons match the other chapters; focus is still shown by the outline. */
.pio-farewell__keycap {
    display: none;
}

.pio-farewell__button-label {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("/Assets/_Game/Shared/Fonts/Outfit/Outfit-SemiBold.ttf");
    font-size: 19px;
    color: rgb(214, 219, 200);
    white-space: nowrap;
}

#return-button { background-color: rgb(67, 85, 61); border-color: rgb(196, 214, 168); }
#return-button .pio-farewell__button-label { color: rgb(238, 241, 222); }
#return-button:hover { background-color: rgb(78, 99, 71); }

/* Keyboard focus: thicker yellow outline (shape and colour, never colour alone). */
.pio-farewell__button--focus,
#return-button.pio-farewell__button--focus {
    border-color: var(--sa-color-focus);
    border-width: 3px;
    padding: 8px 16px;
}

/* ---------- 4:3 (largura lógica < 1100 px, classe aplicada por ResponsiveLayoutClass) ---------- */

.sa-layout--narrow .pio-farewell__title { font-size: 34px; }
.sa-layout--narrow .pio-farewell__subtitle { font-size: 24px; }
.sa-layout--narrow .pio-farewell__choices { bottom: 70px; }
.sa-layout--narrow .pio-farewell__guide { right: var(--sa-space-5); }
