{
  "texts": [
    {
      "key": "SUR-S22",
      "group": "subtitle",
      "pt": "Enquanto havia luz, ela continuou observando.",
      "en": "While there was daylight, it kept observing."
    },
    {
      "key": "SUR-S23",
      "group": "subtitle",
      "pt": "A longa noite lunar chegou. Em 4 de maio, veio o último contato.",
      "en": "The long lunar night arrived. On May 4, contact ended."
    },
    {
      "key": "SUR-S24",
      "group": "subtitle",
      "pt": "Ela não voltou a responder. Mas suas imagens e medidas já estavam na Terra.",
      "en": "It never answered again. But its images and measurements were already on Earth."
    },
    {
      "key": "SUR-S25",
      "group": "subtitle",
      "pt": "Trinta e um meses passaram sobre a mesma paisagem.",
      "en": "Thirty-one months passed over the same landscape."
    },
    {
      "key": "sur.night.title",
      "group": "ui",
      "pt": "A paisagem que ficou",
      "en": "The landscape that remained"
    },
    {
      "key": "sur.night.description",
      "group": "ui",
      "pt": "As imagens e as medidas já viajaram para a Terra. Acompanhe o fim das transmissões e a passagem do tempo na mesma paisagem lunar.",
      "en": "The images and measurements have reached Earth. Watch transmissions end and time pass over the same lunar landscape."
    },
