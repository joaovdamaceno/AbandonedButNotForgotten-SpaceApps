.transit-widget { flex-grow: 1; color: #EEE9DD; }
.transit-accent { color: #EDBF70; }
.transit-title { font-size: 34px; white-space: normal; margin: 14px 0 4px; padding: 0; }
.transit-diagram { flex-grow: 1; min-height: 120px; max-height: 190px; margin: 12px 0 8px; }
.transit-legend { flex-direction: row; justify-content: space-between; margin-bottom: 20px; }
.transit-legend Label { font-size: 17px; padding: 0; }
.transit-desired { color: #9ECAD2; }
.transit-status { color: #C6D2CA; font-size: 23px; margin-bottom: 12px; white-space: normal; padding: 0; }
.transit-meter { height: 4px; background-color: #263443; margin-bottom: 16px; }
.transit-preparation-fill { height: 4px; width: 0; background-color: #EDBF70; }
.transit-radio-meter { height: 3px; margin-top: 20px; margin-bottom: 10px; }
.transit-radio-fill { height: 3px; width: 0; background-color: #9ECAD2; }
.transit-primary { min-height: 52px; margin: 0; padding: 10px 18px; font-size: 20px; color: #101822; background-color: #EDBF70; border-radius: 4px; border-width: 2px; border-color: #EDBF70; white-space: normal; -unity-font-definition: url("/Assets/_Game/Shared/Fonts/Outfit/Outfit-SemiBold.ttf"); }
.transit-primary:hover, .transit-primary:focus { background-color: #FFE0A5; border-color: #FFE0A5; }
.transit-primary:disabled { background-color: #172330; color: #93A0B0; border-color: #354354; }
.transit-copy { font-size: 20px; color: #C0C7CF; padding: 0; white-space: normal; }
.transit-help { font-size: 16px; color: #92A1B3; padding: 0; white-space: normal; margin-top: 12px; }
