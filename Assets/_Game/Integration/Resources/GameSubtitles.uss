/* Legendas da camada do jogo (Marte e Pioneer 10, via GameHost) no mesmo formato das do Surveyor 3 (Chapters/Surveyor/Documentary/Documentary.uss):
   faixa a 13% das laterais e 6,5% da base, placa na largura toda e de cantos retos, fundo escuro a 50% e texto creme de 24 px em Outfit Regular. */
.game-subtitles .sa-subtitle-layer { left: 13%; right: 13%; bottom: 6.5%; }
.game-subtitles .sa-subtitle { width: 100%; max-width: 100%; padding: 8px 16px; background-color: rgba(4, 6, 7, 0.5); border-radius: 0; }
.game-subtitles .sa-subtitle__text { width: 100%; font-size: 24px; white-space: normal; -unity-text-align: middle-center; color: rgb(238, 235, 220); -unity-font-definition: url("/Assets/_Game/Shared/Fonts/Outfit/Outfit-Regular.ttf"); }
