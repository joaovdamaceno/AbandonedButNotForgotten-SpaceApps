<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../SpaceAppsTokens.uss" />
    <Style src="../SpaceAppsComponents.uss" />
    <ui:VisualElement name="sheet-root" class="sa-root sa-sheet sa-chapter--mars">
        <ui:VisualElement class="sa-sheet__cell">
            <ui:Label text="PROMPT E · disponível / rearme / segurando / soltou = pausa / concluído · indisponível = oculto" class="sa-sheet__caption" />
            <ui:VisualElement class="sa-plate sa-hold sa-hold--available">
                <ui:VisualElement class="sa-keycap"><ui:Label text="E" class="sa-keycap__glyph" /></ui:VisualElement>
                <ui:VisualElement class="sa-hold__body">
                    <ui:Label text="E · observar as esferas" class="sa-hold__label" />
                    <ui:Label text="DISPONÍVEL · PRESSIONE E" class="sa-hold__status" />
                    <ui:VisualElement class="sa-progress"><ui:VisualElement class="sa-progress__fill" style="width: 0%;" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="sa-plate sa-hold sa-hold--rearm">
                <ui:VisualElement class="sa-keycap"><ui:Label text="E" class="sa-keycap__glyph" /></ui:VisualElement>
                <ui:VisualElement class="sa-hold__body">
                    <ui:Label text="Solte E para começar" class="sa-hold__label" />
                    <ui:Label text="AGUARDANDO SOLTAR E" class="sa-hold__status" />
                    <ui:VisualElement class="sa-progress"><ui:VisualElement class="sa-progress__fill" style="width: 0%;" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="sa-plate sa-hold sa-hold--holding">
                <ui:VisualElement class="sa-keycap"><ui:Label text="E" class="sa-keycap__glyph" /></ui:VisualElement>
                <ui:VisualElement class="sa-hold__body">
                    <ui:Label text="Segure E · esmerilhar" class="sa-hold__label" />
                    <ui:Label text="OPERANDO · 60%" class="sa-hold__status" />
                    <ui:VisualElement class="sa-progress"><ui:VisualElement class="sa-progress__fill" style="width: 60%;" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="sa-plate sa-hold sa-hold--paused">
                <ui:VisualElement class="sa-keycap"><ui:Label text="E" class="sa-keycap__glyph" /></ui:VisualElement>
                <ui:VisualElement class="sa-hold__body">
                    <ui:Label text="Segure E para continuar" class="sa-hold__label" />
                    <ui:Label text="PAUSADO · 60% PRESERVADO" class="sa-hold__status" />
                    <ui:VisualElement class="sa-progress"><ui:VisualElement class="sa-progress__fill" style="width: 60%;" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="sa-plate sa-hold sa-hold--done">
                <ui:VisualElement class="sa-keycap"><ui:Label text="✓" class="sa-keycap__glyph" /></ui:VisualElement>
                <ui:VisualElement class="sa-hold__body">
                    <ui:Label text="Esmerilhado" class="sa-hold__label" />
                    <ui:Label text="CONCLUÍDO" class="sa-hold__status" />
                    <ui:VisualElement class="sa-progress"><ui:VisualElement class="sa-progress__fill" style="width: 100%;" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="sa-sheet__cell">
            <ui:Label text="BOTÕES · CARIMBOS · SELO · CONFIRMAÇÃO · LEGENDA" class="sa-sheet__caption" />
            <ui:VisualElement style="flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 8px;">
                <ui:Button text="Iniciar" class="sa-button sa-button--primary sa-chapter--mars" style="margin-right: 8px;" />
                <ui:Button text="Iniciar" class="sa-button sa-button--primary sa-chapter--pioneer sa-is-focused" style="margin-right: 8px;" />
                <ui:Button text="Iniciar" class="sa-button sa-button--primary sa-chapter--surveyor" enabled="false" />
            </ui:VisualElement>
            <ui:Label text="normal · foco por teclado (borda amarela 4 px) · desabilitado (45%)" class="sa-sheet__caption" />
            <ui:VisualElement style="flex-direction: row; margin: 8px 0 12px 0;">
                <ui:Button text="Pausa" class="sa-button sa-button--hud" style="margin-right: 8px;" />
                <ui:Button text="Repetir capítulo" class="sa-button sa-button--hud" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; flex-wrap: wrap; margin-bottom: 12px;">
                <ui:Label text="MARTE · 2004" class="sa-stamp sa-chapter--mars sa-stamp--hud" style="margin-right: 16px;" />
                <ui:Label text="PIONEER 10 · 1973" class="sa-stamp sa-chapter--pioneer sa-stamp--hud" style="margin-right: 16px;" />
                <ui:Label text="SURVEYOR 3 · 1967" class="sa-stamp sa-chapter--surveyor sa-stamp--hud" />
            </ui:VisualElement>
            <ui:VisualElement class="sa-seal-imagination" style="align-self: flex-start; margin-bottom: 12px;"><ui:Label text="IMAGINAÇÃO" class="sa-stamp" /></ui:VisualElement>
            <ui:VisualElement class="sa-plate sa-toast" style="align-self: flex-start; margin-bottom: 12px;"><ui:Label text="✓" class="sa-toast__mark" /><ui:Label text="Ferro + níquel · meteorito" class="sa-hold__label" /></ui:VisualElement>
            <ui:VisualElement class="sa-subtitle" style="align-self: flex-start;"><ui:Label text="Mas uma pista não basta. Vamos examinar o interior da rocha." class="sa-subtitle__text" /></ui:VisualElement>
            <ui:Label text="legenda vazia → .sa-subtitle--hidden (display: none), sem placa" class="sa-sheet__caption" style="margin-top: 6px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
