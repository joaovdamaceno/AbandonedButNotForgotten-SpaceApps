<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../SpaceAppsTokens.uss" />
    <Style src="../SpaceAppsComponents.uss" />
    <ui:VisualElement name="hud-root" picking-mode="Ignore" class="sa-root sa-hud sa-chapter--surveyor">
        <ui:VisualElement class="sa-hud__top" picking-mode="Ignore">
            <ui:VisualElement name="objective" class="sa-plate sa-objective">
                <ui:Label text="SURVEYOR 3 · 19 APR 1967" class="sa-stamp sa-stamp--hud" />
                <ui:Label text="Align the destination and send the correction" class="sa-objective__label" />
                <ui:Label text="OCEANUS PROCELLARUM" class="sa-objective__meta" />
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" style="align-items: flex-end;">
            <ui:VisualElement class="sa-plate sa-pause">
                <ui:VisualElement class="sa-icon-pause"><ui:VisualElement class="sa-icon-pause__bar" /><ui:VisualElement class="sa-icon-pause__bar" /></ui:VisualElement>
                <ui:Label text="Pause" class="sa-hold__label" />
                <ui:Label text="P / Esc" class="sa-keyhint" />
            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="sa-edge-cue" picking-mode="Ignore">
            <ui:VisualElement class="sa-plate"><ui:Label text="Target" class="sa-hold__status" /></ui:VisualElement>
            <ui:VisualElement class="sa-edge-cue__arrow" />
        </ui:VisualElement>
        <ui:VisualElement class="sa-plate" picking-mode="Ignore" style="position: absolute; left: 32px; top: 190px; width: 340px;">
            <ui:Label text="COMMAND · EARTH → MOON" class="sa-stamp sa-stamp--hud" />
            <ui:VisualElement class="sa-command">
                <ui:VisualElement class="sa-command__step sa-command__step--done"><ui:VisualElement class="sa-command__dot" /><ui:Label text="Prepared" class="sa-command__text" /></ui:VisualElement>
                <ui:VisualElement class="sa-command__step sa-command__step--done"><ui:VisualElement class="sa-command__dot" /><ui:Label text="Sent" class="sa-command__text" /></ui:VisualElement>
                <ui:VisualElement class="sa-command__step sa-command__step--current"><ui:VisualElement class="sa-command__dot" /><ui:Label text="Command in transit · 1.3 s" class="sa-command__text" /></ui:VisualElement>
                <ui:VisualElement class="sa-command__step"><ui:VisualElement class="sa-command__dot" /><ui:Label text="Executing" class="sa-command__text" /></ui:VisualElement>
                <ui:VisualElement class="sa-command__step"><ui:VisualElement class="sa-command__dot" /><ui:Label text="Command confirmed" class="sa-command__text" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="sa-hud__bottom" picking-mode="Ignore">
            <ui:VisualElement class="sa-plate sa-hold sa-hold--paused">
                <ui:VisualElement class="sa-keycap"><ui:Label text="E" class="sa-keycap__glyph" /></ui:VisualElement>
                <ui:VisualElement class="sa-hold__body">
                    <ui:Label text="Hold E · send the correction" class="sa-hold__label" />
                    <ui:Label text="PAUSED · 60% KEPT" class="sa-hold__status" />
                    <ui:VisualElement class="sa-progress"><ui:VisualElement class="sa-progress__fill" style="width: 60%;" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="subtitle" class="sa-subtitle">
                <ui:Label text="Before sending people to the Moon, we needed to understand the ground they would land on." class="sa-subtitle__text" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
