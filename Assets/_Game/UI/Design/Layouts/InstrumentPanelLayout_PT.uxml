<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../SpaceAppsTokens.uss" />
    <Style src="../SpaceAppsComponents.uss" />
    <ui:VisualElement name="instrument-root" picking-mode="Ignore" class="sa-root sa-hud sa-chapter--surveyor">
        <ui:VisualElement class="sa-hud__top" picking-mode="Ignore">
            <ui:VisualElement class="sa-plate sa-objective">
                <ui:Label text="SURVEYOR 3 · OCEANO DAS TEMPESTADES · 1967" class="sa-stamp sa-stamp--hud" />
                <ui:Label text="Registre a área destacada" class="sa-objective__label" />
                <ui:Label text="2 / 3 · Pata da sonda" class="sa-objective__meta" />
            </ui:VisualElement>
            <ui:VisualElement class="sa-plate sa-pause">
                <ui:VisualElement class="sa-icon-pause"><ui:VisualElement class="sa-icon-pause__bar" /><ui:VisualElement class="sa-icon-pause__bar" /></ui:VisualElement>
                <ui:Label text="Pausa" class="sa-hold__label" />
                <ui:Label text="P / Esc" class="sa-keyhint" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="frame-target" picking-mode="Ignore" style="position: absolute; left: 20%; top: 36%; width: 260px; height: 170px; border-width: 3px; border-color: #F2B84B; border-radius: 4px; justify-content: flex-end;">
            <ui:Label text="PATA DA SONDA" class="sa-stamp sa-stamp--hud" style="background-color: rgba(12, 14, 18, 0.92); padding: 2px 6px; align-self: flex-start;" />
        </ui:VisualElement>
        <ui:VisualElement name="instrument" class="sa-instrument">
            <ui:Label text="INSTRUMENTO · TV · ESPELHO" class="sa-stamp sa-stamp--hud" />
            <ui:Label text="Câmera de TV" class="sa-instrument__title" />
            <ui:VisualElement class="sa-readout"><ui:Label text="Lente" class="sa-readout__label" /><ui:Label text="Visão ampla · 25 mm" class="sa-readout__value" /></ui:VisualElement>
            <ui:VisualElement class="sa-readout"><ui:Label text="Alvo" class="sa-readout__label" /><ui:Label text="Pata da sonda" class="sa-readout__value" /></ui:VisualElement>
            <ui:VisualElement class="sa-command">
                <ui:VisualElement class="sa-command__step sa-command__step--done"><ui:VisualElement class="sa-command__dot" /><ui:Label text="Preparado" class="sa-command__text" /></ui:VisualElement>
                <ui:VisualElement class="sa-command__step sa-command__step--done"><ui:VisualElement class="sa-command__dot" /><ui:Label text="Enviado" class="sa-command__text" /></ui:VisualElement>
                <ui:VisualElement class="sa-command__step sa-command__step--current"><ui:VisualElement class="sa-command__dot" /><ui:Label text="Comando em trânsito · 1,3 s" class="sa-command__text" /></ui:VisualElement>
                <ui:VisualElement class="sa-command__step"><ui:VisualElement class="sa-command__dot" /><ui:Label text="Executando" class="sa-command__text" /></ui:VisualElement>
                <ui:VisualElement class="sa-command__step"><ui:VisualElement class="sa-command__dot" /><ui:Label text="Comando confirmado" class="sa-command__text" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="sa-result">
                <ui:Label text="REGISTRO 1 / 3" class="sa-stamp sa-stamp--hud" />
                <ui:Label text="✓ Marca da aterrissagem" class="sa-result__text" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="sa-hud__bottom" picking-mode="Ignore">
            <ui:VisualElement class="sa-plate sa-hold sa-hold--rearm">
                <ui:VisualElement class="sa-keycap"><ui:Label text="E" class="sa-keycap__glyph" /></ui:VisualElement>
                <ui:VisualElement class="sa-hold__body">
                    <ui:Label text="Solte E para começar" class="sa-hold__label" />
                    <ui:Label text="AGUARDANDO SOLTAR E" class="sa-hold__status" />
                    <ui:VisualElement class="sa-progress"><ui:VisualElement class="sa-progress__fill" style="width: 0%;" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
