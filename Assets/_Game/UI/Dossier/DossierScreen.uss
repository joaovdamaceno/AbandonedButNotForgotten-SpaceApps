/*
 * UI-002 · Dossiê funcional (R2). Só estende o sistema da UI-001: nenhuma cor ou tamanho novos fora dos tokens.
 * Estados mudam por classe (EnableInClassList) e sempre acompanham texto/forma, nunca só cor.
 * Fontes do USS ficam no .ttf (ver Docs/Art/UI_SPEC.md).
 */

/* ---------- Erro de carregamento ---------- */

.sa-dossier__error {
    -unity-font-definition: url("/Assets/_Game/Shared/Fonts/Outfit/Outfit-SemiBold.ttf");
    font-size: var(--sa-text-body);
    color: var(--sa-color-paper);
    background-color: var(--sa-color-ink);
    border-left-width: 6px;
    border-left-color: var(--sa-color-warn);
    padding: var(--sa-space-3) var(--sa-space-4);
    margin: 0 0 var(--sa-space-3) 0;
    white-space: normal;
    display: none;
}

.sa-dossier__error--visible {
    display: flex;
}

/* ---------- Pasta ---------- */

/* Capítulo ainda sem definição no catálogo: aviso explícito, sem botão ativo. */
.sa-folder__status {
    -unity-font-definition: url("/Assets/_Game/Shared/Fonts/IBMPlexMono/IBMPlexMono-SemiBold.ttf");
    font-size: 15px;
    color: var(--sa-color-ink);
    background-color: var(--sa-color-paper-shade);
    border-width: 1px;
    border-color: var(--sa-color-ink-muted);
    padding: 2px var(--sa-space-2);
    margin: 0 0 var(--sa-space-3) 0;
    white-space: normal;
    display: none;
}

.sa-folder__status--visible {
    display: flex;
}

/* ---------- Rodapé: idioma ---------- */

.sa-dossier__footer-label {
    margin: 0 var(--sa-space-3) 0 0;
}

.unity-button.sa-lang {
    min-width: 56px;
    padding: 0 var(--sa-space-3);
    margin-right: var(--sa-space-2);
}

/* Idioma ativo: preenchido (forma + cor). */
.unity-button.sa-lang--active {
    background-color: var(--sa-color-ink);
    border-color: var(--sa-color-ink);
    color: var(--sa-color-paper);
}

.sa-dossier__footer-group .unity-button.sa-button--link {
    margin-left: var(--sa-space-2);
}

/* ---------- Painel sobreposto (detalhes · configurações · créditos) ---------- */

.sa-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(31, 26, 20, 0.82);
    align-items: center;
    justify-content: center;
    padding: var(--sa-space-5);
    display: none;
}

.sa-modal--open {
    display: flex;
}

.sa-modal__card {
    width: 100%;
    max-width: 720px;
    max-height: 100%;
    background-color: var(--sa-color-paper);
    border-width: 1px;
    border-color: var(--sa-color-paper-edge);
    border-top-width: 6px;
    border-top-color: var(--sa-accent);
    border-radius: var(--sa-radius-sm);
    padding: var(--sa-space-5);
}

.sa-modal__title {
    -unity-font-definition: url("/Assets/_Game/Shared/Fonts/Outfit/Outfit-Bold.ttf");
    font-size: var(--sa-text-title);
    color: var(--sa-color-ink);
    margin: var(--sa-space-1) 0 var(--sa-space-3) 0;
    padding: 0;
    white-space: normal;
}

.sa-modal__body {
    flex-grow: 0;
    flex-shrink: 1;
    margin-bottom: var(--sa-space-4);
}

.sa-modal__actions {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
}

.sa-modal__actions .unity-button {
    margin-left: var(--sa-space-3);
}

.sa-modal__question {
    -unity-font-definition: url("/Assets/_Game/Shared/Fonts/Outfit/Outfit-SemiBold.ttf");
    font-size: var(--sa-text-question);
    color: var(--sa-color-ink);
    margin: var(--sa-space-2) 0 var(--sa-space-3) 0;
    white-space: normal;
}

.sa-modal__text {
    font-size: var(--sa-text-body);
    color: var(--sa-color-ink);
    margin: 0 0 var(--sa-space-3) 0;
    white-space: normal;
}

.sa-modal__text--muted {
    color: var(--sa-color-ink-muted);
}

.sa-modal__section {
    margin: var(--sa-space-3) 0 var(--sa-space-1) 0;
}

/* Linhas de configuração: rótulo à esquerda, controles à direita. */
.sa-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: var(--sa-hit-min);
    margin-bottom: var(--sa-space-2);
}

.sa-row__label {
    font-size: var(--sa-text-body);
    color: var(--sa-color-ink);
    flex-shrink: 1;
    white-space: normal;
    margin: 0 var(--sa-space-3) 0 0;
}

.sa-row__controls {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.sa-row__value {
    -unity-font-definition: url("/Assets/_Game/Shared/Fonts/IBMPlexMono/IBMPlexMono-SemiBold.ttf");
    font-size: var(--sa-text-body);
    color: var(--sa-color-ink);
    min-width: 72px;
    margin: 0;
    -unity-text-align: middle-center;
}

.unity-button.sa-step {
    min-width: var(--sa-hit-min);
    padding: 0 var(--sa-space-3);
}

/* Interruptor ligado: preenchido; o texto "Ligado/Desligado" é o portador principal do estado. */
.unity-button.sa-toggle--on {
    background-color: var(--sa-color-ink);
    border-color: var(--sa-color-ink);
    color: var(--sa-color-paper);
}

/* ---------- Carregamento ---------- */

.sa-loading {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--sa-color-paper-shade);
    align-items: center;
    justify-content: center;
    padding: var(--sa-space-6);
    display: none;
}

.sa-loading--visible {
    display: flex;
}

.sa-loading__title {
    -unity-font-definition: url("/Assets/_Game/Shared/Fonts/Outfit/Outfit-Bold.ttf");
    font-size: var(--sa-text-title);
    color: var(--sa-color-ink);
    margin: var(--sa-space-2) 0 0 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: normal;
}

.sa-loading__chapter {
    -unity-font-definition: url("/Assets/_Game/Shared/Fonts/Outfit/Outfit-SemiBold.ttf");
    font-size: var(--sa-text-question);
    color: var(--sa-accent);
    margin: var(--sa-space-1) 0 0 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: normal;
}

.sa-loading__track {
    width: 360px;
    max-width: 100%;
    height: 12px;
    margin: var(--sa-space-5) 0 var(--sa-space-3) 0;
    background-color: var(--sa-color-paper-edge);
    border-radius: var(--sa-radius-sm);
    overflow: hidden;
}

.sa-loading__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 35%;
    background-color: var(--sa-accent);
    border-radius: var(--sa-radius-sm);
}

/* Movimento reduzido: barra parada; o texto "Preparando a cena…" continua indicando o carregamento. */
.sa-loading__fill--static {
    opacity: 0.7;
}

.sa-loading__note {
    font-size: var(--sa-text-label);
    color: var(--sa-color-ink-muted);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: normal;
}

.sa-loading__hint {
    font-size: var(--sa-text-label);
    color: var(--sa-color-ink);
    margin: var(--sa-space-3) 0 0 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: normal;
    display: none;
}

.sa-loading__hint--visible {
    display: flex;
}
