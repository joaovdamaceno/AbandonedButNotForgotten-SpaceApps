  "missing_recordings": [
    {
      "chapter": "pioneer",
      "key": "PIO.05.01b",
      "subtitle_en": "It carried a message for anyone who might find it: a golden plaque with no words."
    },
    {
      "chapter": "pioneer",
      "key": "PIO.05.01c",
      "subtitle_en": "Just pictures and symbols, showing who we are and where we came from."
    },
    {
      "chapter": "mars",
      "key": "v13.years.work",
      "subtitle_en": "The ninety-sol mission kept going. Rock by rock, the story of Mars gained new detail."
    },
    {
      "chapter": "mars",
      "key": "v15.storm.dark",
      "subtitle_en": "With little light on its solar panels, Opportunity stopped driving and saved energy. For weeks, almost everything stayed switched off."
    }
  ],
